@{
    ViewData["Title"] = "لیست کارکنان";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@model List<Mhrm.Models.ViewModels.EmployeeDetails>

<style>
    .employee-list-page {
        direction: rtl;
        text-align: right;
        width: 100%;
    }

    .employee-table-wrap {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        border: 1px solid #edf2f7;
        padding: 18px;
        overflow-x: auto;
    }

    .employee-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

    .employee-table th,
    .employee-table td {
        padding: 14px 12px;
        border-bottom: 1px solid #eef2f7;
        text-align: right;
        vertical-align: middle;
        font-size: 14px;
    }

    .employee-table thead th {
        background: #f8fafc;
        color: #334155;
        font-weight: 700;
    }

    .employee-table tbody tr:hover {
        background: #f8fbff;
    }

    .employee-table a {
        color: #1f2937;
        text-decoration: none;
    }

    .employee-table a:hover {
        color: #1d4ed8;
    }

    .btn-delete-employee {
        border: none;
        background: transparent;
        color: #dc2626;
        font-size: 18px;
        cursor: pointer;
    }

    .employee-empty {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.04);
        color: #6b7280;
        padding: 24px;
        text-align: center;
    }
</style>

<div class="employee-list-page">
    @if (Model != null && Model.Any())
    {
        <div class="employee-table-wrap">
            <table class="employee-table">
                <thead>
                    <tr>
                        <th>شناسه</th>
                        <th>نام و نام خانوادگی</th>
                        <th>کد ملی</th>
                        <th>تلفن</th>
                        <th>نقش</th>
                        <th>نام کاربری</th>
                        <th>بیو</th>
                        <th>حذف</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Employeemenu" asp-action="Details" asp-route-id="@emp.Employee.Id">
                                    @emp.Employee.Id
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Employeemenu" asp-action="Details" asp-route-id="@emp.Employee.Id">
                                    @emp.Employee.FirstName @emp.Employee.LastName
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Employeemenu" asp-action="Details" asp-route-id="@emp.Employee.Id">
                                    @emp.Employee.National_id
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Employeemenu" asp-action="Details" asp-route-id="@emp.Employee.Id">
                                    @emp.Employee.Phone
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Employeemenu" asp-action="Details" asp-route-id="@emp.Employee.Id">
                                    @(emp.User != null ? emp.User.RoleId.ToString() : "ندارد")
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Employeemenu" asp-action="Details" asp-route-id="@emp.Employee.Id">
                                    @(emp.User != null ? emp.User.Username : "ندارد")
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Employeemenu" asp-action="Details" asp-route-id="@emp.Employee.Id">
                                    @(emp.User != null ? emp.User.Bio : "ندارد")
                                </a>
                            </td>
                            <td>
                                <button type="button" class="btn-delete-employee" data-id="@emp.Employee.Id" title="حذف کارمند">
                                    ❌
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="employee-empty">
            هیچ کارمندی ثبت نشده است.
        </div>
    }
</div>

<script>
document.querySelectorAll(".btn-delete-employee").forEach(btn => {
    btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        if (!confirm("آیا از حذف این کارمند مطمئن هستید؟")) return;

        try {
            const res = await fetch("@Url.Action("DeleteEmployee", "NewAccount")", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(id)
            });

            if (res.ok) {
                btn.closest("tr").remove();
                alert("کارمند با موفقیت حذف شد ✅");
            } else {
                alert("خطا در حذف کارمند ❌");
            }
        } catch (err) {
            console.error(err);
            alert("خطا در ارتباط با سرور.");
        }
    });
});
</script>
