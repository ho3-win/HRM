@model Mhrm.Models.ViewModels.EmployeeDetails

@{
    ViewData["Title"] = "جزئیات کارمند";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

<style>

.employee-page {
    font-family: "Vazirmatn", sans-serif;
    background-color: #f7f8fb;
    color: #333333;
    margin: 20px;
    direction: rtl;
    text-align: right;
}

.employee-page .row {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 10px;
    width: 100%;
    flex-direction: row;
}

.employee-page .col {
    flex: 1 1 220px;
    min-width: 220px;
    display: flex;
    flex-direction: column;
}

.employee-page .col.large {
    min-width: 100%;
    flex-basis: 100%;
}

label, .view, .edit {
    text-align: right;
}

input.edit {
    direction: rtl;
    text-align: right;
}

.employee-page h2 {
    display: block;
    width: 100%;
    text-align: right !important;
    margin: 18px 0 10px 0;
    color: #444;
    font-size: 1.3rem;
}

.employee-page .card {
    display: block;
    background: #fff;
    padding: 18px 20px;
    border-radius: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,.05);
    margin-bottom: 20px;
    transition: box-shadow 0.3s ease;
    border: 2px solid gold;
}

.employee-page .card:hover {
    box-shadow: 0 4px 12px rgba(0,0,0,.1);
}


label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #555;
    margin-bottom: 6px;
}

.view {
    padding: 8px 10px;
    background: #f0f3f9;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color .2s ease;
}
.view:hover { background: #e0e4ed; }

.edit {
    display: none;
    padding: 8px 10px;
    border: 1px solid #ccd1dd;
    border-radius: 6px;
    font-size: 0.95rem;
    outline: none;
    transition: border-color .3s ease;
}
.edit:focus {
    border-color: #5b8dfd;
}


.btn {
    margin-top: 16px;
    padding: 9px 18px;
    border: none;
    border-radius: 6px;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color .2s ease, transform .1s ease;
   
}

.btn-primary {
    background-color: #4a7bf5;
    color: #fff;
}
.btn-primary:hover {
    background-color: #3c68ce;
}

.btn-success {
    background-color: #23c586;
    color: #fff;
}
.btn-success:hover {
    background-color: #1ea972;
}

.btn:active {
    transform: scale(0.98);
}

.contract-row{
    border-bottom:1px solid #ddd;
    padding:10px 0;
    margin-bottom:10px;
}

.btn-danger{
    background-color: #e90404;
    color: #fff;
}
.btn-danger:hover{
    background-color: #c50303;
}

</style>

<div class="employee-page">
    <hr/>
    <h2>اطلاعات کارمند</h2>

    <div class="card">
        
        <div class="row">
            <div class="col">
                <label>Id</label>
                <span class="view" data-field="Id">@Model.Employee.Id</span>
                <input class="edit" data-field="Id" value="@Model.Employee.Id" />
            </div>

        </div>

        <div class="row">
            <div class="col">
                <label>نام</label>
                <span class="view" data-field="FirstName">@Model.Employee.FirstName</span>
                <input class="edit" data-field="FirstName" value="@Model.Employee.FirstName" />
            </div>

            <div class="col">
                <label>نام خانوادگی</label>
                <span class="view" data-field="LastName">@Model.Employee.LastName</span>
                <input class="edit" data-field="LastName" value="@Model.Employee.LastName" />
            </div>
        </div>

        <div class="row">
            <div class="col">
                <label>کد ملی</label>
                <span class="view" data-field="National_id">@Model.Employee.National_id</span>
                <input class="edit" data-field="National_id" value="@Model.Employee.National_id" />
            </div>

            <div class="col">
                <label>شماره موبایل</label>
                <span class="view" data-field="Phone">@Model.Employee.Phone</span>
                <input class="edit" data-field="Phone" value="@Model.Employee.Phone" />
            </div>
        </div>

        <div class="row">
            <div class="col">
                <label>تاریخ تولد  </label>
                <span class="view" data-field="BirthDate">@Model.Employee.BirthDate?.ToString("yyyy/MM/dd")</span>
                <input class="edit" type="date" data-field="BirthDate" value="@(Model.Employee.BirthDate?.ToString("yyyy-MM-dd")?? "null")" />
            </div>

            <div class="col">
                <label>ایمیل</label>
                <span class="view" data-field="Email">@Model.Employee.Email </span>
                <input class="edit" data-field="Email" value="@Model.Employee.Email" />
            </div>
        </div>

        <div class="row">
            <div class="col">
                <label>تاریخ استخدام   </label>
                <span class="view" data-field="HireDate">@Model.Employee.HireDate?.ToString("yyyy/MM/dd")</span>
                <input class="edit" type="date" data-field="HireDate" value="@(Model.Employee.HireDate?.ToString("yyyy-MM-dd")?? "null")" />
            </div>

            <div class="col">
                <label>وضعیت </label>
                <span class="view" data-field="Status">@Model.Employee.Status</span>
                <input class="edit" data-field="Status" value="@Model.Employee.Status" />
            </div>
        </div>

        <div class="row">
            <div class="col">
                <label>  شماره بیمه  </label>
                <span class="view" data-field="InsuranceNumber">@Model.Employee.InsuranceNumber</span>
                <input class="edit" data-field="InsuranceNumber" value="@Model.Employee.InsuranceNumber" />
            </div>

            <div class="col">
                <label> عنوان شغلی</label>
                <span class="view" data-field="DepartmentPositionId">@Model.Employee.DepartmentPositionId</span>
                <input class="edit" data-field="DepartmentPositionId" value="@Model.Employee.DepartmentPositionId" />
            </div>
        </div>

        <button id="btnSaveEmployee" class="btn btn-primary">
            ذخیره اطلاعات کارمند
        </button>
    </div>

