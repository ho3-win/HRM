<script>
    function previewDocument(path) {

        const ext = path.split('.').pop().toLowerCase();

        let html = "";

        // تصاویر
        if (["jpg", "jpeg", "png", "gif", "webp"].includes(ext)) {

            html = `
                <img src="${path}"
                    class="img-fluid rounded shadow" />
            `;
        }

        // pdf
        else if (ext === "pdf") {

            html = `
                <iframe src="${path}"
                        width="100%"
                        height="700px">
                </iframe>
            `;
        }

        // ویدیو
        else if (["mp4", "webm", "ogg"].includes(ext)) {

            html = `
                <video controls width="100%">
                    <source src="${path}">
                </video>
            `;
        }

        // فایل‌های دیگر
        else {

            html = `
                <a href="${path}"
                target="_blank"
                class="btn btn-primary">
                دانلود فایل
                </a>
            `;
        }

        document.getElementById("previewBody").innerHTML = html;

        const modal = new bootstrap.Modal(
            document.getElementById('previewModal')
        );

        modal.show();
    }



    // متغیر کمکی برای تشخیص ویرایش یا ثبت جدید قرارداد
    let selectedContractId = null;

    //  تابع کمکی برای ارسال داده به سرور (فقط یک بار تعریف شود) 
    async function postData(url, data) {

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        let options = {
            method: "POST",
            headers: {
                "RequestVerificationToken": token
            }
        };

        if (data instanceof FormData) {
            options.body = data;

        } else {
            options.headers["Content-Type"] = "application/json";
            options.body = JSON.stringify(data);
        }

        const res = await fetch(url, options);

        const responseText = await res.text();
        console.log("Server Response:", res.status, responseText);

        return res.ok;
    }


    // تابع کمکی برای خواندن مقدار از اینپوت‌های ویرایش اطلاعات کارمند
    function getVal(fieldName, type = "string") {
        const el = document.querySelector(`input[data-field="${fieldName}"]`);
        if (!el) return null;
        const v = el.value.trim();
        if (v === "") return null;
        if (type === "int") return parseInt(v) || 0;
        return v;
    }

    //  مدیریت نمایش فیلدهای ویرایش اطلاعات کارمند 
    document.querySelectorAll(".view").forEach(span => {
        span.addEventListener("click", () => {
            const field = span.dataset.field;
            const card = span.closest(".card");
            if (!card) return;

            const input = card.querySelector(`input[data-field="${field}"]`);
            if (!input) return;

            span.style.display = "none";
            input.style.display = "block";
            input.focus();

            const saveBtn = card.querySelector(".btn-primary, .btn-success");
            if (saveBtn) saveBtn.style.display = "inline-block";
        });
    });

    //ذخیره اطلاعات اصلی کارمند 
    document.getElementById("btnSaveEmployee")?.addEventListener("click", async () => {
        const payload = {
            Id: @Model.Employee.Id,
            FirstName: getVal("FirstName"),
            LastName: getVal("LastName"),
            Phone: getVal("Phone"),
            National_id: getVal("National_id"),
            Email: getVal("Email"),
            BirthDate: getVal("BirthDate"),
            HireDate: getVal("HireDate"),
            Status: getVal("Status", "int"),
            InsuranceNumber: getVal("InsuranceNumber"),
            DepartmentPositionId: getVal("DepartmentPositionId", "int")
        };
        const ok = await postData("@Url.Action("UpdateEmployee")", payload);
        ok ? location.reload() : alert("خطا در ذخیره اطلاعات کارمند");
    });

    



 

    // مدیریت مدارک، مرخصی و درخواست‌ها 
    document.getElementById("btnAddDoc")?.addEventListener("click", () => document.getElementById("newDocForm").style.display = "block");
    let selectedDocId = null;

    function editDocument(id, title, file, desc) {

        selectedDocId = id;

        document.getElementById("newDocForm").style.display = "block";

        document.getElementById("dTitle").value = title;
        document.getElementById("dDesc").value = desc;
    }


    document.getElementById("btnSaveDoc")?.addEventListener("click", async () => {

        const fileInput = document.getElementById("dFile");
        const file = fileInput.files[0];

        const payload = new FormData();

        payload.append("Id", selectedDocId || 0);
        payload.append("EmployeeId", @Model.Employee.Id);
        payload.append("Title", document.getElementById("dTitle").value);
        payload.append("Description", document.getElementById("dDesc").value);

        if (file)
            payload.append("file", file);

        const url = selectedDocId
            ? "@Url.Action("UpdateDocument")"
            : "@Url.Action("CreateDocument")";

        const res = await fetch(url, {
            method: "POST",
            body: payload
        });

        res.ok ? location.reload() : alert("خطا در ذخیره مدرک");
    });


   



    document.getElementById("btnSaveUser")?.addEventListener("click", async () => {

        const payload = {

            Id: @Model.User?.Id,

            EmployeeId: @Model.Employee.Id,

            Username:
                document.querySelector('input[data-field="Username"]').value,

            Bio:
                document.querySelector('input[data-field="Bio"]').value,

            Password:
                document.querySelector('input[data-field="Password"]').value,

            RoleId:
                parseInt(
                    document.querySelector('input[data-field="RoleId"]').value
                ) || 0
        };

        const ok = await postData(
            "@Url.Action("UpdateUser")",
            payload
        );

        ok
            ? location.reload()
            : alert("خطا در ذخیره اطلاعات یوزر");
    });


    




    let selectedRequestId = null;

    document.getElementById("btnAddRequest")?.addEventListener("click", () => {

        selectedRequestId = null;

        document.getElementById("newRequestForm").style.display = "block";

        document.getElementById("rDesc").value = "";
        document.getElementById("rStatus").value = "";
        document.getElementById("rLeaveRequest").value = "false";
        document.getElementById("rStartDate").value = "";
        document.getElementById("rEndDate").value = "";
        document.getElementById("rApprovedBy").value = "";

        document.getElementById("btnSaveRequest").textContent = "ثبت درخواست";
    });



    document.getElementById("btnSaveRequest")?.addEventListener("click", async () => {

        const startDate = document.getElementById("rStartDate").value;
        const endDate = document.getElementById("rEndDate").value;
        const approvedByValue = document.getElementById("rApprovedBy").value;

        const payload = {
            Id: selectedRequestId || 0,
            RequestBy: @Model.Employee.Id,
            LeaveRequest: document.getElementById("rLeaveRequest").value === "true",
            StartDate: startDate ? startDate : null,
            EndDate: endDate ? endDate : null,
            Description: document.getElementById("rDesc").value,
            Status: "Pending",
            ApprovedBy: approvedByValue ? parseInt(approvedByValue) : null
        };

        console.log("Request payload:", payload);

        const url = selectedRequestId
            ? "@Url.Action("UpdateRequest")"
            : "@Url.Action("CreateRequest")";

        const ok = await postData(url, payload);

        ok
            ? location.reload()
            : alert("خطا در ثبت درخواست");
    });



    function editRequest(
        id,
        desc,
        status,
        leaveRequest,
        startDate,
        endDate,
        approvedBy
    ) {

        selectedRequestId = id;

        const form = document.getElementById("newRequestForm");
        form.style.display = "block";

        document.getElementById("rDesc").value = desc || "";

        document.getElementById("rStatus").value = status || "";

        document.getElementById("rLeaveRequest").value =
            leaveRequest === "True" || leaveRequest === "true"
                ? "true"
                : "false";

        document.getElementById("rStartDate").value = startDate || "";

        document.getElementById("rEndDate").value = endDate || "";

        document.getElementById("rApprovedBy").value = approvedBy || "";

        document.getElementById("btnSaveRequest").textContent =
            "ویرایش درخواست";
    }


    async function deleteRequest(id) {

        if (!confirm("آیا از حذف درخواست مطمئن هستید؟"))
            return;

        const ok = await postData("@Url.Action("DeleteRequest")", id);

        ok
            ? location.reload()
            : alert("خطا در حذف درخواست");
    }

    function downloadDocument(path) {

        const link = document.createElement("a");

        link.href = path;

        // استخراج نام فایل
        const fileName = path.split("/").pop();

        link.download = fileName;

        document.body.appendChild(link);

        link.click();

        document.body.removeChild(link);
    }

</script>
