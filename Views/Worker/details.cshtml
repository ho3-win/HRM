@model Mhrm.Models.ViewModels.EmployeeDetails

@{
    ViewData["Title"] = "جزئیات کارمند";

    Layout = "~/Views/Shared/_WorkerLayout.cshtml";
}

<style>
    .employee-page {
        font-family: "Vazirmatn", sans-serif;
        background-color: #f7f8fb;
        color: #333;
        margin: 20px;
        direction: rtl;
        text-align: right;
    }

    .row {
        flex-direction: row;
    }

    label,
    .view,
    .edit {
        text-align: right;
    }

    input.edit {
        direction: rtl;
        text-align: right;
    }

    .employee-page h2 {
        display: block;
        width: 100%;
        text-align: right !important;
        margin: 18px 0 10px 0;
        color: #444;
        font-size: 1.3rem;
    }



    .card {
        background: #fff;
        padding: 18px 20px;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, .05);
        margin-bottom: 20px;
        transition: box-shadow 0.3s ease;
        border: 2px solid gold;
    }

    .card:hover {
        box-shadow: 0 4px 12px rgba(0, 0, 0, .1);
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 10px;
    }

    .col {
        flex: 1;
        min-width: 220px;
        display: flex;
        flex-direction: column;
    }

    .col.large {
        min-width: 100%;
    }

    label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #555;
        margin-bottom: 6px;
    }

    .view {
        padding: 8px 10px;
        background: #f0f3f9;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color .2s ease;
    }

    .view:hover {
        background: #e0e4ed;
    }

    .edit {
        display: none;
        padding: 8px 10px;
        border: 1px solid #ccd1dd;
        border-radius: 6px;
        font-size: 0.95rem;
        outline: none;
        transition: border-color .3s ease;
    }

    .edit:focus {
        border-color: #5b8dfd;
    }


    .btn {
        margin-top: 16px;
        padding: 9px 18px;
        border: none;
        border-radius: 6px;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background-color .2s ease, transform .1s ease;

    }

    .btn-primary {
        background-color: #4a7bf5;
        color: #fff;
    }

    .btn-primary:hover {
        background-color: #3c68ce;
    }

    .btn-success {
        background-color: #23c586;
        color: #fff;
    }

    .btn-success:hover {
        background-color: #1ea972;
    }

    .btn:active {
        transform: scale(0.98);
    }

    .contract-row {
        border-bottom: 1px solid #ddd;
        padding: 10px 0;
        margin-bottom: 10px;
    }

    .btn-danger {
        background-color: #e90404;
        color: #fff;
    }

    .btn-danger:hover {
        background-color: #c50303;
    }
</style>

