@model List<NewsVM>
@{
    Layout = "~/Views/Shared/_WorkerLayout.cshtml";
    ViewData["Title"] = "پنل کاربر";
    var latestNews = Model.FirstOrDefault();
}

<style>
    :root {
        --primary-yellow: #f1b80d;
        --dark-text: #1e1e24;
        --card-bg: #ffffff;
        --text-main: #2b2b2b;
        --text-muted: #6c757d;
        --border-radius: 20px;
    }

    .worker-dashboard {
        font-family: Tahoma, 'Vazirmatn', sans-serif;
        background-color: #f4f6f9;
        margin: 0;
        padding: 0;
        direction: rtl;
    }

    .worker-dashboard * {
        box-sizing: border-box;
    }

    .worker-dashboard .profile-logout {
        margin-right: auto;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .worker-dashboard .logout-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--primary-yellow);
        border: none;
        color: var(--dark-text);
        text-decoration: none;
        font-weight: bold;
        font-size: 1.05rem;
        padding: 10px 16px;
        border-radius: 12px;
        cursor: pointer;
        transition: filter 0.2s ease;
    }

    .worker-dashboard .logout-btn:hover {
        filter: brightness(0.96);
    }

    .worker-dashboard .dashboard-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 30px 60px;
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .worker-dashboard .profile-card {
        background: linear-gradient(135deg, #fff8d6 0%, #ffffff 100%);
        border-radius: var(--border-radius);
        padding: 30px 35px;
        display: flex;
        align-items: center;
        gap: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        border-right: 8px solid #d9b209;
    }

    .worker-dashboard .avatar-wrapper {
        position: relative;
        width: 110px;
        height: 110px;
        flex-shrink: 0;
    }

    .worker-dashboard .avatar-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid var(--primary-yellow);
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
    }

    .worker-dashboard .profile-info {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100%;
    }

    .worker-dashboard .user-name {
        margin: 0;
        font-size: 1.6rem;
        color: var(--text-main);
        font-weight: bold;
    }

    .worker-dashboard .info-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 25px;
        margin-top: 5px;
    }

    .worker-dashboard .info-item {
        font-size: 1.05rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f8f9fa;
        padding: 8px 16px;
        border-radius: 10px;
    }

    .worker-dashboard .info-item i {
        color: var(--primary-yellow);
        font-size: 1.2rem;
    }

    .worker-dashboard .info-item span {
        color: var(--text-main);
        font-weight: 600;
    }

    .worker-dashboard .news-card {
        background: var(--card-bg);
        border-radius: var(--border-radius);
        padding: 25px 35px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none;
        color: var(--text-main);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.03);
        border: 2px solid transparent;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .worker-dashboard .news-content {
        display: flex;
        align-items: center;
        gap: 20px;
        flex: 1;
    }

    .worker-dashboard .news-badge {
        background: rgba(241, 184, 13, 0.2);
        color: #8c6a00;
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 0.95rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .worker-dashboard .news-text {
        font-size: 1.1rem;
        color: var(--text-main);
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 700px;
    }

    .worker-dashboard .news-action {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1rem;
        color: var(--text-muted);
        font-weight: bold;
        white-space: nowrap;
    }

    .worker-dashboard .news-card:hover {
        transform: translateY(-4px);
        border-color: var(--primary-yellow);
        box-shadow: 0 10px 25px rgba(241, 184, 13, 0.18);
    }

    .worker-dashboard .news-card:hover .news-action i {
        transform: translateX(-6px);
    }

    .worker-dashboard .action-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .worker-dashboard .action-card {
        background: var(--card-bg);
        border-radius: var(--border-radius);
        padding: 35px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        text-decoration: none;
        color: var(--text-main);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.03);
        border: 2px solid transparent;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .worker-dashboard .action-card .icon-box {
        width: 70px;
        height: 70px;
        border-radius: 16px;
        background: rgba(241, 184, 13, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: #b88a00;
        transition: all 0.3s ease;
    }

    .worker-dashboard .action-card span {
        font-weight: bold;
        font-size: 1.15rem;
        text-align: center;
    }

    .worker-dashboard .action-card:hover {
        transform: translateY(-6px);
        border-color: var(--primary-yellow);
        box-shadow: 0 12px 25px rgba(241, 184, 13, 0.2);
    }

    .worker-dashboard .action-card:hover .icon-box {
        background: var(--primary-yellow);
        color: #fff;
    }

    @@media (max-width: 992px) {
        .worker-dashboard .action-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .worker-dashboard .news-text {
            max-width: 350px;
        }
    }

    @@media (max-width: 576px) {
        .worker-dashboard .action-grid {
            grid-template-columns: 1fr;
        }

        .worker-dashboard .profile-card {
            flex-direction: column;
            text-align: center;
        }

        .worker-dashboard .info-grid {
            justify-content: center;
        }

        .worker-dashboard .news-card {
            flex-direction: column;
            gap: 15px;
            align-items: flex-start;
        }
    }

    .ai-widget-container {
        position: fixed;
        bottom: 16px;
        left: 16px;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        font-family: Tahoma, 'Vazirmatn', sans-serif;
        pointer-events: none;
        transition: transform 0.25s ease, opacity 0.2s ease, visibility 0.2s ease;
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
    }

    .ai-widget-container.is-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(0);
    }

    .ai-widget-container.is-lifted {
        transform: translateY(-8px);
    }

    .ai-float-btn {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background-color: #6c5ce7;
        color: #fff;
        border: none;
        box-shadow: 0 8px 24px rgba(108, 92, 231, 0.4);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        transition: all 0.25s ease;
        pointer-events: auto;
        transform: translateY(0);
    }

    .ai-float-btn:hover {
        transform: scale(1.08);
        box-shadow: 0 12px 28px rgba(108, 92, 231, 0.5);
    }

    .ai-btn-label {
        margin-top: 6px;
        font-size: 0.72rem;
        font-weight: bold;
        color: #2b2b2b;
        background: rgba(255, 255, 255, 0.9);
        padding: 3px 8px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
        backdrop-filter: blur(4px);
        pointer-events: none;
    }

    .ai-chat-window {
        position: fixed;
        bottom: 76px;
        left: 16px;
        width: 360px;
        height: 480px;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
        display: none;
        flex-direction: column;
        overflow: hidden;
        z-index: 2;
        border: 1px solid #eee;
        direction: rtl;
        font-family: Tahoma, 'Vazirmatn', sans-serif;
    }

    .ai-chat-header {
        background: #6c5ce7;
        color: #fff;
        padding: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ai-chat-header .title {
        font-weight: bold;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ai-chat-close {
        background: transparent;
        border: none;
        color: #fff;
        font-size: 1.2rem;
        cursor: pointer;
    }

    .ai-chat-body {
        flex: 1;
        padding: 15px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: #f8f9fa;
    }

    .chat-message {
        max-width: 80%;
        padding: 10px 14px;
        border-radius: 14px;
        font-size: 0.95rem;
        line-height: 1.4;
        word-break: break-word;
    }

    .chat-message.bot {
        background: #fff;
        color: #333;
        align-self: flex-start;
        border-bottom-right-radius: 2px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .chat-message.user {
        background: #6c5ce7;
        color: #fff;
        align-self: flex-end;
        border-bottom-left-radius: 2px;
    }

    .ai-chat-footer {
        padding: 12px;
        background: #fff;
        display: flex;
        gap: 8px;
        border-top: 1px solid #eee;
    }

    .ai-chat-input {
        flex: 1;
        border: 1px solid #ddd;
        border-radius: 20px;
        padding: 8px 14px;
        font-family: inherit;
        outline: none;
    }

    .ai-chat-send {
        background: #6c5ce7;
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 38px;
        height: 38px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @@media (max-width: 576px) {
        .ai-chat-window {
            width: calc(100% - 40px);
            left: 20px;
        }
    }
</style>

<div class="worker-dashboard">
    <div class="dashboard-container">
        <div class="profile-card">
            <div class="avatar-wrapper">
                <img src="@(User.FindFirst("Photo")?.Value ?? Url.Content("~/images/Userdefult.png"))" alt="عکس پرسنلی"
                     class="avatar-img" />
            </div>

            <div class="profile-info">
                <h2 class="user-name">@User.Identity?.Name</h2>
                <div class="info-grid">
                    <div class="info-item"><i class="fa-solid fa-id-card"></i> کد پرسنلی: <span>@(ViewBag.EmployeePersonnelCode ?? "نامشخص")</span></div>
                    <div class="info-item"><i class="fa-solid fa-cake-candles"></i> سن: <span>@(ViewBag.EmployeeAgeText ?? "نامشخص")</span></div>
                    <div class="info-item"><i class="fa-solid fa-user-check"></i> وضعیت: <span>@(ViewBag.EmployeeStatusText ?? "کارمند فعال")</span></div>
                </div>
            </div>

            <div class="profile-logout">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-btn">
                        خروج
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </form>
            </div>
        </div>

        <a href="@Url.Action("NewsList", "Worker")" class="news-card">
            <div class="news-content">
                <div class="news-badge"><i class="fa-solid fa-bullhorn"></i> اخبار مهم</div>
                <div class="news-text">@(latestNews != null ? latestNews.Title : "در حال حاضر خبری برای نمایش وجود ندارد.")</div>
            </div>
            <div class="news-action"><span>مشاهده همه اخبار</span><i class="fa-solid fa-arrow-left"></i></div>
        </a>

        <div class="action-grid">
            <a asp-controller="Worker" asp-action="Details" fragment="contracts" class="action-card">
                <div class="icon-box"><i class="fa-solid fa-file-contract"></i></div>
                <span>قراردادها</span>
            </a>
            <a asp-controller="Worker" asp-action="Details" fragment="documents" class="action-card">
                <div class="icon-box"><i class="fa-solid fa-folder-open"></i></div>
                <span>مدارک</span>
            </a>
            <a asp-controller="Worker" asp-action="Details" fragment="leave-requests" class="action-card">
                <div class="icon-box"><i class="fa-solid fa-calendar-minus"></i></div>
                <span>مرخصی‌ها</span>
            </a>
            <a asp-controller="Worker" asp-action="Details" fragment="requests" class="action-card">
                <div class="icon-box"><i class="fa-solid fa-paper-plane"></i></div>
                <span>درخواست‌ها</span>
            </a>
        </div>

        <div class="action-grid">
            <a href="#" class="action-card">
                <div class="icon-box"><i class="fa-solid fa-receipt"></i></div>
                <span>فیش‌های حقوقی</span>
            </a>
            <a href="#" class="action-card">
                <div class="icon-box"><i class="fa-solid fa-comment-dots"></i></div>
                <span>انتقادات و پیشنهادات</span>
            </a>
            <a asp-controller="Survey" asp-action="Index" class="action-card">
                <div class="icon-box"><i class="fa-solid fa-poll"></i></div>
                <span>نظرسنجی‌ها</span>
            </a>
            <a href="#" class="action-card">
                <div class="icon-box"><i class="fa-solid fa-circle-info"></i></div>
                <span>درباره ما</span>
            </a>
        </div>
    </div>

    <div class="ai-widget-container" id="aiWidgetContainer">
        <button class="ai-float-btn" id="aiToggleBtn" type="button" aria-label="دستیار هوش مصنوعی">
            <i class="fa-solid fa-robot"></i>
        </button>
        <span class="ai-btn-label">دستیار</span>
    </div>

    <div class="ai-chat-window" id="aiChatWindow">
        <div class="ai-chat-header">
            <div class="title"><i class="fa-solid fa-robot"></i> دستیار هوشمند</div>
            <button class="ai-chat-close" id="aiCloseBtn" type="button" aria-label="بستن چت">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="chat-message bot">سلام! چطور می‌توانم کمکتان کنم؟</div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" class="ai-chat-input" id="aiInput" placeholder="سوال خود را بنویسید..." />
            <button class="ai-chat-send" id="aiSendBtn" type="button" aria-label="ارسال پیام">
                <i class="fa-solid fa-paper-plane"></i>
            </button>
        </div>
    </div>
</div>

<script>
    const aiToggleBtn = document.getElementById('aiToggleBtn');
    const aiCloseBtn = document.getElementById('aiCloseBtn');
    const aiChatWindow = document.getElementById('aiChatWindow');
    const aiSendBtn = document.getElementById('aiSendBtn');
    const aiInput = document.getElementById('aiInput');
    const aiChatBody = document.getElementById('aiChatBody');
    const aiWidgetContainer = document.getElementById('aiWidgetContainer');
    let assistantLockedToBottom = false;

    function lockAssistantAtBottom() {
        if (aiChatWindow.style.display === 'flex') {
            return;
        }

        assistantLockedToBottom = true;
        aiWidgetContainer.classList.remove('is-lifted');
        aiWidgetContainer.classList.remove('is-hidden');
        aiWidgetContainer.style.bottom = '16px';
        aiWidgetContainer.style.left = '16px';
        aiWidgetContainer.style.transform = 'translateY(0)';
    }

    function closeAssistantChat() {
        aiChatWindow.style.display = 'none';
        aiWidgetContainer.classList.remove('is-hidden');
        lockAssistantAtBottom();
    }

    function openAssistantChat() {
        aiChatWindow.style.display = 'flex';
        aiWidgetContainer.classList.add('is-hidden');
        aiWidgetContainer.classList.remove('is-lifted');
        aiWidgetContainer.style.transform = 'translateY(0)';
    }

    window.addEventListener('scroll', () => {
        if (!assistantLockedToBottom || aiChatWindow.style.display !== 'flex') {
            lockAssistantAtBottom();
        }
    }, { passive: true });

    aiToggleBtn.addEventListener('click', () => {
        if (aiChatWindow.style.display === 'flex') {
            closeAssistantChat();
        } else {
            openAssistantChat();
        }
    });

    aiCloseBtn.addEventListener('click', () => {
        closeAssistantChat();
    });

    function appendMessage(text, sender) {
        const msgDiv = document.createElement('div');
        msgDiv.classList.add('chat-message', sender);
        msgDiv.textContent = text;
        aiChatBody.appendChild(msgDiv);
        aiChatBody.scrollTop = aiChatBody.scrollHeight;
        return msgDiv;
    }

    function getFallbackReply(question) {
        const value = question.toLowerCase();

        if (value.includes('سلام') || value.includes('درود') || value.includes('hello')) {
            return 'سلام! خوش‌آمدید. در خدمت شما هستم.';
        }

        if (value.includes('مرخصی') || value.includes('leave')) {
            return 'برای بررسی درخواست مرخصی، به بخش مرخصی‌ها در پنل کاربری مراجعه کنید.';
        }

        if (value.includes('قرارداد') || value.includes('contract')) {
            return 'در بخش قراردادها می‌توانید جزئیات قرارداد خود را مشاهده کنید.';
        }

        if (value.includes('مدارک') || value.includes('document')) {
            return 'مدارک شما در بخش مدارک موجود است و می‌توانید آن‌ها را بررسی کنید.';
        }

        return 'ببخشید، در حال حاضر سرویس هوش مصنوعی در دسترس نیست. لطفاً بعداً دوباره تلاش کنید یا از بخش‌های موجود پنل استفاده کنید.';
    }

    function extractAiAnswer(payload, rawText) {
        if (!payload && !rawText) return '';

        if (payload && typeof payload === 'object') {
            return payload.answer || payload.response || payload.message || payload.text || payload.reply || '';
        }

        if (typeof payload === 'string') {
            return payload.trim();
        }

        if (typeof rawText === 'string') {
            const trimmed = rawText.trim();
            if (!trimmed) return '';

            try {
                const parsed = JSON.parse(trimmed);
                return parsed?.answer || parsed?.response || parsed?.message || parsed?.text || parsed?.reply || trimmed;
            } catch {
                return trimmed;
            }
        }

        return '';
    }

    async function sendMessage() {
        const text = aiInput.value.trim();
        if (!text) return;

        appendMessage(text, 'user');
        aiInput.value = '';

        const loadingMsg = appendMessage('در حال پاسخ‌دهی...', 'bot');
        const fallbackReply = getFallbackReply(text);

        try {
            const response = await fetch('@Url.Action("AskAi", "Home")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                },
                body: new URLSearchParams({ question: text })
            });

            const result = await response.json();
            const answer = result?.answer || fallbackReply;
            loadingMsg.textContent = answer;
        } catch (error) {
            loadingMsg.textContent = fallbackReply;
        }
    }

    aiSendBtn.addEventListener('click', sendMessage);
    aiInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
    });
</script>
