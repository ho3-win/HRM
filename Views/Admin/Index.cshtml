@model List<NewsVM>

@{
    ViewData["Title"] = "داشبورد مدیریت";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

<div class="dashboard-grid">
    <div class="card">
        <div class="card-info">
            <h3>تعداد کل کارکنان</h3>
            <div class="value">@((ViewBag.EmployeeCount ?? 0)) نفر</div>
        </div>
        <div class="card-icon">
            <i class="fa-solid fa-users-gear"></i>
        </div>
    </div>

    <div class="card">
        <div class="card-info">
            <h3>آخرین خبر ثبت‌شده</h3>
            <div class="value" style="font-size:1.1rem;">تغییر ساعات کاری تابستان</div>
        </div>
        <div class="card-icon">
            <i class="fa-solid fa-bullhorn"></i>
        </div>
    </div>

    <div class="card time-card">
        <div class="card-info">
            <h3>ساعت و تاریخ زنده</h3>
            <div class="value" id="liveClock">00:00:00</div>
            <div id="liveDate" style="font-size:0.8rem; margin-top:5px; color:#ecf0f1;">-</div>
        </div>
        <div class="card-icon" style="background: rgba(255,255,255,0.1); color: #f1c40f;">
            <i class="fa-regular fa-clock"></i>
        </div>
    </div>
</div>

<div class="banner-section">
    <img src="~/images/LOGO.jpg" alt="MHRM Logo" class="banner-logo" />
    <h2>به سامانه مدیریت منابع انسانی خوش آمدید</h2>
    <p>
        این سامانه با هدف تسهیل فرآیندهای اداری، دسترسی سریع به اطلاعات کارکنان، ثبت درخواست‌ها،
        مشاهده اطلاعیه‌ها و بهبود ارتباطات سازمان طراحی شده است.
    </p>
</div>

@if (TempData["Success"] != null)
{
    <div style="background:#d4edda;padding:10px;border-radius:8px;margin:20px 0;">
        @TempData["Success"]
    </div>
}

<div class="news-section">
    <div class="news-topbar">
        <h3 style="font-size:1.1rem; color: var(--dark-gray);">اخبار و اطلاعیه‌ها</h3>
        <a class="btn" asp-action="Createnew">افزودن خبر</a>
    </div>

    @if (!Model.Any())
    {
        <div class="news-empty">
            <h3>هیچ خبری وجود ندارد</h3>
            <p>برای شروع یک خبر جدید اضافه کنید</p>
        </div>
    }
    else
    {
        <div class="news-grid">
            @foreach (var item in Model)
            {
                <div class="news-card @(item.IsImportant ? "important" : "")">
                    @if (!string.IsNullOrEmpty(item.FilePath))
                    {
                        var ext = System.IO.Path.GetExtension(item.FilePath).ToLower();

                        if (ext == ".mp4" || ext == ".webm" || ext == ".ogg")
                        {
                            <video controls>
                                <source src="@item.FilePath" type="video/mp4" />
                                مرورگر شما از پخش ویدئو پشتیبانی نمی‌کند.
                            </video>
                        }
                        else
                        {
                            <img src="@item.FilePath" alt="@item.Title" />
                        }
                    }
                    else
                    {
                        <div
                            style="height:180px;background:#ccc;display:flex;align-items:center;justify-content:center;color:#444;">
                            بدون فایل
                        </div>
                    }

                    <div class="news-card-body">
                        <div class="category">
                            دسته‌بندی:
                            @switch (item.Category)
                            {
                                case 0:
                                    <span>عمومی</span>
                                    break;
                                case 1:
                                    <span>شرکت</span>
                                    break;
                                case 2:
                                    <span>رویداد</span>
                                    break;
                                case 3:
                                    <span>آموزشی</span>
                                    break;
                                default:
                                    <span>سایر</span>
                                    break;
                            }
                        </div>
                        <div class="title">@item.Title</div>

                        <div class="text">
                            @(string.IsNullOrEmpty(item.Content)
                                ? "بدون توضیح"
                                : item.Content)
                        </div>

                        <div class="footer">
                            <span>@item.CreatedAt.ToString("yyyy/MM/dd")</span>
                            @if (!item.IsActive)
                            {
                                <span class="badge">غیرفعال</span>
                            }
                        </div>

                        <div class="meta" style="margin-top: 12px; font-size: 12px; color: #666;">
                            منتشر کننده: @item.EmployeeFirstName @item.EmployeeLastName (@item.EmployeeId)
                        </div>

                        <div class="news-actions">
                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="delete-bt" type="submit"
                                        onclick="return confirm('آیا از حذف این خبر مطمئن هستید؟')">
                                    حذف
                                </button>
                            </form>

                            <form asp-action="ToggleActive" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                @if (item.IsActive)
                                {
                                    <button type="submit" class="btn-status active">
                                        غیرفعال کردن
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn-status inactive">
                                        فعال کردن
                                    </button>
                                }
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
